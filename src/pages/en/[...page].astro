---
import { createClient } from '@supabase/supabase-js';
import Footer from '../../components/Footer.astro';
import { toSlug } from '../../utils/slug';

export async function getStaticPaths({ paginate }) {
  const supabaseUrl = 'https://lffmkpexmtjwtvlgvkcj.supabase.co';
  const supabaseKey = 'sb_publishable_2GbOzXCVwdEOeZj62jhTPA_cuWUn2Bs';
  const supabase = createClient(supabaseUrl, supabaseKey);

  const { data: herramientas, error } = await supabase
    .from('herramientas')
    .select('*')
    .order('estrellas', { ascending: false });

  if (error) {
    console.error('Error al consultar Supabase:', error);
    return [];
  }

  const items = herramientas || [];
  const categorias = ['All', ...new Set(items.map((h) => h.categoria_en || h.categoria).filter(Boolean))];

  // Datos ligeros para la búsqueda global en memoria con slug incluido
  const catalogoCompleto = items.map((h) => ({
    id: h.id,
    slug: h.slug || toSlug(h.nombre || ''),
    nombre: h.nombre || '',
    saas_alternativa: h.saas_alternativa || '',
    categoria: h.categoria_en || h.categoria || '',
    descripcion: h.descripcion_en || h.descripcion || '',
    estrellas: h.estrellas || 0,
  }));

  return paginate(items, {
    pageSize: 12,
    props: { 
      categorias,
      catalogoCompleto
    },
  });
}

const { page, categorias, catalogoCompleto } = Astro.props;
const currentNum = page.currentPage;
const urlEs = currentNum === 1 ? '/' : `/${currentNum}`;
const urlEn = currentNum === 1 ? '/en' : `/en/${currentNum}`;
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SelfHostDeck | Self-Hosted vs SaaS Directory (Page {page.currentPage})</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Metadatos SEO y Open Graph -->
  <meta name="description" content="Discover the best self-hosted and open-source alternatives to commercial SaaS. Take full control of your data and homelab." />
  <link rel="canonical" href={`https://selfhostdeck.com${urlEn}`} />
  <link rel="alternate" hreflang="en" href={`https://selfhostdeck.com${urlEn}`} />
  <link rel="alternate" hreflang="es" href={`https://selfhostdeck.com${urlEs}`} />
  <link rel="alternate" hreflang="x-default" href={`https://selfhostdeck.com${urlEn}`} />

  <!-- Tarjetas para Redes -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://selfhostdeck.com/en" />
  <meta property="og:site_name" content="SelfHostDeck" />
  <meta property="og:title" content="SelfHostDeck | Find Self-Hosted SaaS Alternatives" />
  <meta property="og:description" content="Discover powerful open-source tools to replace commercial cloud software." />
  <meta property="og:image" content="https://selfhostdeck.com/og-image.png" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://selfhostdeck.com/en" />
  <meta name="twitter:title" content="SelfHostDeck | Find Self-Hosted SaaS Alternatives" />
  <meta name="twitter:description" content="Discover powerful open-source tools to replace commercial cloud software." />
  <meta name="twitter:image" content="https://selfhostdeck.com/og-image.png" />
  
  <style is:global>
    :root {
      --bg: #0b1120;
      --card-bg: #1e293b;
      --card-border: #334155;
      --primary: #38bdf8;
      --primary-glow: rgba(56, 189, 248, 0.2);
      --text: #e2e8f0;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1.5rem;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Cabecera */
    header {
      text-align: center;
      margin-bottom: 3rem;
    }
    h1 {
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      background: linear-gradient(to right, #38bdf8, #818cf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin: 0 0 0.75rem 0;
    }
    .subtitulo {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto 2rem auto;
      line-height: 1.5;
    }

    /* Botonera de navegación destacada */
    .cta-group {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.85rem;
      margin: 1.5rem auto 2.5rem auto;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      padding: 0.65rem 1.25rem;
      border-radius: 8px;
      text-decoration: none;
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .cta-btn-primary {
      background: #0284c7;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
    }

    .cta-btn-primary:hover {
      background: #0369a1;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
    }

    .cta-btn-secondary {
      background: #131d31;
      color: #e2e8f0;
      border: 1px solid var(--card-border);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }

    .cta-btn-secondary:hover {
      background: #1e293b;
      border-color: var(--primary);
      color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(56, 189, 248, 0.15);
    }

    .cta-badge {
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      background: rgba(56, 189, 248, 0.15);
      color: var(--primary);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
    }

    /* Contenedor del Buscador */
    .search-wrapper {
      max-width: 680px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .search-input-group {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-icon {
      position: absolute;
      left: 1.25rem;
      width: 20px;
      height: 20px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      padding: 1rem 1rem 1rem 3.25rem;
      background: #131d31;
      border: 1px solid var(--card-border);
      border-radius: 12px;
      color: #ffffff;
      font-size: 1rem;
      outline: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px var(--primary-glow), 0 4px 20px -2px rgba(0, 0, 0, 0.4);
      background: #17233d;
    }

    .search-input::placeholder {
      color: #64748b;
    }

    /* Filtros en píldoras */
    .filter-pills {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .pill {
      background: #1e293b;
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      padding: 0.4rem 0.9rem;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .pill:hover {
      background: #28364d;
      color: #ffffff;
    }

    .pill.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #38bdf8;
    }

    /* Contador */
    .counter {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }

    /* Grid de tarjetas */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.5rem;
    }

    .card {
      position: relative;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: inherit;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: 0 10px 25px -5px var(--primary-glow);
    }

    /* Stretched link */
    .main-link {
      color: #ffffff;
      text-decoration: none;
    }

    .main-link::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .badge {
      display: inline-block;
      background: #0369a1;
      color: #bae6fd;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      margin-bottom: 0.75rem;
      width: fit-content;
      position: relative;
      z-index: 2;
    }

    h2 {
      margin: 0 0 0.5rem 0;
      font-size: 1.35rem;
      font-weight: 700;
    }

    .reemplaza {
      color: #cbd5e1;
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
      position: relative;
      z-index: 2;
    }
    .reemplaza strong { color: #f59e0b; }

    /* Estilo del enlace a la alternativa */
    .sub-link {
      color: #cbd5e1;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 0.15s ease;
    }
    .sub-link:hover {
      color: var(--primary);
    }

    .resumen {
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }

    .meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid var(--card-border);
      padding-top: 1rem;
    }

    .estrellas {
      color: #facc15;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .btn {
      color: var(--primary);
      font-size: 0.9rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      transition: gap 0.15s ease;
    }

    .card:hover .btn {
      text-decoration: underline;
      gap: 0.5rem;
    }

    .no-results {
      display: none;
      text-align: center;
      color: var(--text-muted);
      font-size: 1.1rem;
      grid-column: 1 / -1;
      padding: 4rem 0;
    }

    /* Paginación Numérica */
    .pagination {
      grid-column: 1 / -1;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      margin-top: 3.5rem;
      margin-bottom: 1rem;
    }

    .page-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.4rem;
      height: 2.4rem;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text);
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .page-link:hover:not(.disabled) {
      border-color: var(--primary);
      background: #28364d;
      color: #ffffff;
      transform: translateY(-1px);
    }

    .page-link.disabled {
      opacity: 0.3;
      pointer-events: none;
      cursor: not-allowed;
    }

    .page-numbers {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .page-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.4rem;
      height: 2.4rem;
      padding: 0 0.5rem;
      border-radius: 8px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text);
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .page-num:hover:not(.active) {
      border-color: var(--primary);
      background: #28364d;
      color: #ffffff;
      transform: translateY(-1px);
    }

    .page-num.active {
      background: #0284c7;
      border-color: var(--primary);
      color: #ffffff;
      pointer-events: none;
    }

    /* Barra superior y selector de idioma */
    .top-nav {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 1rem;
    }

    .lang-switch {
      display: inline-flex;
      align-items: center;
      background: #131d31;
      border: 1px solid var(--card-border);
      border-radius: 9999px;
      padding: 0.2rem 0.5rem;
      gap: 0.35rem;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .lang-switch a {
      color: var(--text-muted);
      text-decoration: none;
      padding: 0.25rem 0.6rem;
      border-radius: 9999px;
      transition: all 0.2s ease;
    }

    .lang-switch a:hover {
      color: #ffffff;
    }

    .lang-switch a.active {
      background: #0284c7;
      color: #ffffff;
    }

    .lang-divider {
      color: #334155;
      font-size: 0.75rem;
      user-select: none;
    }
  </style>
</head>
<body>
  <header>
    <!-- Selector de Idioma -->
    <div class="top-nav">
      <div class="lang-switch">
        <a href={urlEs}>ES</a>
        <span class="lang-divider">/</span>
        <a href={urlEn} class="active">EN</a>
      </div>
    </div>
    <h1>Self-Hosted Open-Source Directory</h1>
    <p class="subtitulo">Privacy-first and free alternatives to commercial software, analyzed locally with AI.</p>

    <!-- Botonera de navegación destacada -->
    <div class="cta-group">
      <a href="/stacks" class="cta-btn cta-btn-primary">
        ⚡ Explore Homelab Docker Stacks
      </a>
      <a href="/en/stacker" class="cta-btn cta-btn-secondary">
        🧩 Docker Compose Stacker
        <span class="cta-badge">New</span>
      </a>
    </div>
      
    <div class="search-wrapper">
      <div class="search-input-group">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input 
          type="text" 
          id="buscador" 
          class="search-input" 
          placeholder="Search by tool, SaaS alternative, or technology (e.g. Photos, Notion, n8n)..." 
        />
      </div>

      <div class="filter-pills" id="contenedor-filtros">
        {categorias.map((cat) => (
          <button class={`pill ${cat === 'All' ? 'active' : ''}`} data-cat={cat.toLowerCase()}>
            {cat}
          </button>
        ))}
      </div>
    </div>
  </header>

  <div class="counter" id="contador-resultados">
    Showing {page.start + 1} - {page.end + 1} of {page.total} tools (Page {page.currentPage} of {page.lastPage})
  </div>

  <main class="grid" id="contenedor-cards">
    <!-- Contenedor estático paginado -->
    <div id="cards-estaticas" style="display: contents;">
      {page.data.map((item) => (
        <article class="card">
          <div>
            <span class="badge">{item.categoria_en || item.categoria}</span>
            <h2>
              <a href={`/en/herramienta/${item.slug || toSlug(item.nombre)}`} class="main-link">
                {item.nombre}
              </a>
            </h2>
            <p class="reemplaza">
              <strong>Alternative to:</strong>{" "}
              {item.saas_alternativa ? item.saas_alternativa.split('/').map((s: string, idx: number, arr: string[]) => {
                const name = s.trim();
                const slug = toSlug(name);
                return (
                  <>
                    <a href={`/en/alternatives/${slug}`} class="sub-link">{name}</a>
                    {idx < arr.length - 1 ? ' / ' : ''}
                  </>
                );
              }) : 'N/A'}
            </p>
            <p class="resumen">{item.descripcion_en || item.descripcion}</p>
          </div>
          <div class="meta">
            <span class="estrellas">★ {item.estrellas}</span>
            <span class="btn">
              View analysis <span>&rarr;</span>
            </span>
          </div>
        </article>
      ))}
    </div>

    <!-- Contenedor dinámico para búsquedas globales -->
    <div id="cards-dinamicas" style="display: contents;"></div>

    <div id="sin-resultados" class="no-results">
      🔍 No tools found matching your search across the catalog.
    </div>

    <!-- Paginación Numérica -->
    <nav class="pagination" id="nav-paginacion" aria-label="Page navigation">
      {page.url.prev ? (
        <a href={page.url.prev} class="page-link" aria-label="Previous page">←</a>
      ) : (
        <span class="page-link disabled" aria-hidden="true">←</span>
      )}

      <div class="page-numbers">
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => {
          const url = num === 1 ? '/en' : `/en/${num}`;
          const isActive = num === page.currentPage;
          return isActive ? (
            <span class="page-num active" aria-current="page">{num}</span>
          ) : (
            <a href={url} class="page-num">{num}</a>
          );
        })}
      </div>

      {page.url.next ? (
        <a href={page.url.next} class="page-link" aria-label="Next page">→</a>
      ) : (
        <span class="page-link disabled" aria-hidden="true">→</span>
      )}
    </nav>
  </main>

  <Footer />

  <!-- Índice JSON global incrustado -->
  <script id="catalogo-datos" type="application/json" set:html={JSON.stringify(catalogoCompleto)} />

  <script>
    interface Tool {
      id: string | number;
      slug: string;
      nombre: string;
      saas_alternativa: string;
      categoria: string;
      descripcion: string;
      estrellas: number;
    }

    function toSlug(text: string): string {
      return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    const catalogoEl = document.getElementById('catalogo-datos');
    const todosLosDatos: Tool[] = catalogoEl ? JSON.parse(catalogoEl.textContent || '[]') : [];

    const buscador = document.getElementById('buscador') as HTMLInputElement;
    const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
    const contador = document.getElementById('contador-resultados');
    const sinResultados = document.getElementById('sin-resultados');
    const navPaginacion = document.getElementById('nav-paginacion');
    const cardsEstaticas = document.getElementById('cards-estaticas');
    const cardsDinamicas = document.getElementById('cards-dinamicas');

    const textoContadorOriginal = contador?.textContent || '';
    let currentCategory = 'all';

    function escaparHTML(texto: string) {
      const div = document.createElement('div');
      div.textContent = texto;
      return div.innerHTML;
    }

    function crearTarjetaHTML(item: Tool) {
      const linksSaaS = item.saas_alternativa
        ? item.saas_alternativa.split('/').map((s, idx, arr) => {
            const nombre = s.trim();
            const slug = toSlug(nombre);
            const sep = idx < arr.length - 1 ? ' / ' : '';
            return `<a href="/en/alternatives/${slug}" class="sub-link">${escaparHTML(nombre)}</a>${sep}`;
          }).join('')
        : 'N/A';

      return `
        <article class="card">
          <div>
            <span class="badge">${escaparHTML(item.categoria)}</span>
            <h2>
              <a href="/en/herramienta/${escaparHTML(item.slug)}" class="main-link">
                ${escaparHTML(item.nombre)}
              </a>
            </h2>
            <p class="reemplaza"><strong>Alternative to:</strong> ${linksSaaS}</p>
            <p class="resumen">${escaparHTML(item.descripcion)}</p>
          </div>
          <div class="meta">
            <span class="estrellas">★ ${item.estrellas}</span>
            <span class="btn">
              View analysis <span>&rarr;</span>
            </span>
          </div>
        </article>
      `;
    }

    function filtrarGlobal() {
      const query = buscador.value.toLowerCase().trim();
      const estaBuscando = query !== '' || currentCategory !== 'all';

      if (!estaBuscando) {
        if (cardsEstaticas) cardsEstaticas.style.display = 'contents';
        if (cardsDinamicas) {
          cardsDinamicas.style.display = 'none';
          cardsDinamicas.innerHTML = '';
        }
        if (navPaginacion) navPaginacion.style.display = 'flex';
        if (sinResultados) sinResultados.style.display = 'none';
        if (contador) contador.textContent = textoContadorOriginal;
        return;
      }

      if (cardsEstaticas) cardsEstaticas.style.display = 'none';
      if (cardsDinamicas) cardsDinamicas.style.display = 'contents';
      if (navPaginacion) navPaginacion.style.display = 'none';

      const coincidencias = todosLosDatos.filter((item) => {
        const matchText =
          item.nombre.toLowerCase().includes(query) ||
          item.saas_alternativa.toLowerCase().includes(query) ||
          item.categoria.toLowerCase().includes(query) ||
          item.descripcion.toLowerCase().includes(query);

        const matchCat =
          currentCategory === 'all' ||
          item.categoria.toLowerCase() === currentCategory;

        return matchText && matchCat;
      });

      if (cardsDinamicas) {
        cardsDinamicas.innerHTML = coincidencias.map(crearTarjetaHTML).join('');
      }

      if (sinResultados) {
        sinResultados.style.display = coincidencias.length === 0 ? 'block' : 'none';
      }

      if (contador) {
        contador.textContent = `Showing ${coincidencias.length} tool${coincidencias.length === 1 ? '' : 's'} found in catalog`;
      }
    }

    buscador?.addEventListener('input', filtrarGlobal);

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        currentCategory = pill.dataset.cat || 'all';
        filtrarGlobal();
      });
    });
  </script>

  <script is:inline define:vars={{ numPagina: page.currentPage }}>
    sessionStorage.setItem('ultimaPaginaCatalogo', String(numPagina));
