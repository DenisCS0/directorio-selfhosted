  <body>
    <div class="container">
      <div class="top-nav">
        <a href="/en" class="volver">&larr; Back to catalog</a>
        <div class="lang-switch">
          <a href="/stacker">ES</a>
          <a href="/en/stacker" class="active">EN</a>
        </div>
      </div>

      <div class="header-section">
        <h1>Docker Compose Stacker</h1>
        <p class="sub">
          Select the tools you need and generate a unified file ready to run on your server.
        </p>
      </div>

      <div class="stacker-grid">
        <!-- Left Panel: Selection -->
        <div class="panel">
          <input
            type="text"
            id="searchInput"
            class="search-box"
            placeholder="Search by name or alternative (e.g. Plex, Immich, Notion)..."
          />

          <div class="filter-pills" id="categoryFilters">
            <button class="pill active" data-cat="all">All</button>
            {categorias.map((cat) => (
              <button class="pill" data-cat={cat}>{cat}</button>
            ))}
          </div>

          <div class="tools-list" id="toolsContainer"></div>
        </div>

        <!-- Right Panel: Code Viewer -->
        <div class="sticky-panel">
          <div class="panel">
            <div class="stack-header-row">
              <span style="font-weight: 700;">Your Stack:</span>
              <button class="btn-clear" id="btnClearStack">Clear stack</button>
            </div>

            <div class="selected-chips" id="selectedChips">
              <span style="color: #64748b; font-size: 0.85rem;">No tools selected</span>
            </div>

            <div class="alert-box" id="collisionAlert"></div>

            <div class="yaml-container">
              <div class="yaml-header">
                <!-- Tab Controls -->
                <div class="code-tabs">
                  <button type="button" class="tab-btn active" id="tabYaml">docker-compose.yml</button>
                  <button type="button" class="tab-btn" id="tabEnv">.env <span id="envBadge" class="tab-badge">0</span></button>
                </div>

                <div class="yaml-actions">
                  <button class="btn-action" id="btnShare">Share</button>
                  <button class="btn-action" id="btnDownload">Download</button>
                  <button class="btn-action" id="btnCopy">Copy</button>
                </div>
              </div>
              <pre class="yaml-code"><code id="codeOutput"># Select tools from the left panel to compose your stack.</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Data injection without runtime requests -->
    <script define:vars={{ herramientasDisponibles }}>
      window.ALL_TOOLS = herramientasDisponibles;
    </script>

    <script is:inline>
      let selectedSlugs = new Set();
      let currentCategory = 'all';
      let searchQuery = '';
      let activeTab = 'yaml'; // 'yaml' | 'env'
      let currentYaml = '';
      let currentEnv = '';

      const toolsContainer = document.getElementById('toolsContainer');
      const selectedChips = document.getElementById('selectedChips');
      const codeOutput = document.getElementById('codeOutput');
      const collisionAlert = document.getElementById('collisionAlert');
      const searchInput = document.getElementById('searchInput');
      const categoryFilters = document.getElementById('categoryFilters');
      const btnCopy = document.getElementById('btnCopy');
      const btnDownload = document.getElementById('btnDownload');
      const btnShare = document.getElementById('btnShare');
      const btnClearStack = document.getElementById('btnClearStack');
      const tabYaml = document.getElementById('tabYaml');
      const tabEnv = document.getElementById('tabEnv');
      const envBadge = document.getElementById('envBadge');

      function generarPasswordSegura(longitud = 20) {
        const chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_';
        const array = new Uint8Array(longitud);
        window.crypto.getRandomValues(array);
        return Array.from(array, byte => chars[byte % chars.length]).join('');
      }

      function extraerEnvAutomatico(finalStack) {
        if (!finalStack.services || Object.keys(finalStack.services).length === 0) {
          return { texto: '# No environment variables required.', total: 0 };
        }

        const envPorServicio = {};
        const clavesContrasena = /(password|secret|key|token|auth|salt|hash)/i;
        let totalCount = 0;

        // Shared database passwords registry
        const sharedPasswords = {
          postgres: null,
          mysql: null,
          redis: null
        };

        function resolverPassword(clave) {
          const k = clave.toLowerCase();

          // PostgreSQL bound variables
          if (k.includes('postgres')) {
            if (!sharedPasswords.postgres) {
              sharedPasswords.postgres = generarPasswordSegura();
            }
            return sharedPasswords.postgres;
          }

          // MySQL / MariaDB bound variables
          if (k.includes('mysql') || k.includes('mariadb')) {
            if (!sharedPasswords.mysql) {
              sharedPasswords.mysql = generarPasswordSegura();
            }
            return sharedPasswords.mysql;
          }

          // Redis bound variables
          if (k.includes('redis')) {
            if (!sharedPasswords.redis) {
              sharedPasswords.redis = generarPasswordSegura();
            }
            return sharedPasswords.redis;
          }

          // Generic database password when postgres is present
          if (k.includes('db_password') || k.includes('database_password')) {
            if (finalStack.services.postgres || finalStack.services.db) {
              if (!sharedPasswords.postgres) {
                sharedPasswords.postgres = generarPasswordSegura();
              }
              return sharedPasswords.postgres;
            }
          }

          // Standalone cryptographic secrets (JWT, SECRET_KEY, ENCRYPTION_KEY...)
          return generarPasswordSegura();
        }

        for (const [servicio, def] of Object.entries(finalStack.services)) {
          const varsServicio = {};

          if (def.environment) {
            if (Array.isArray(def.environment)) {
              def.environment.forEach(item => {
                const [k, ...v] = String(item).split('=');
                if (k) varsServicio[k.trim()] = v.join('=').trim();
              });
            } else if (typeof def.environment === 'object') {
              Object.entries(def.environment).forEach(([k, v]) => {
                varsServicio[k] = String(v ?? '');
              });
            }
          }

          const stringDef = JSON.stringify(def);
          const coincidencias = stringDef.matchAll(/\$\{([A-Z0-9_]+)(?::-([^}]*))?\}/gi);
          for (const match of coincidencias) {
            const varName = match[1];
            const defaultVal = match[2] || '';
            if (varsServicio[varName] === undefined) {
              varsServicio[varName] = defaultVal;
            }
          }

          for (const [clave, valor] of Object.entries(varsServicio)) {
            const esPassword = clavesContrasena.test(clave);
            const esPlaceholder = !valor || ['password', 'changeme', 'secret', 'admin', 'tu_clave'].includes(valor.toLowerCase());

            if (esPassword && esPlaceholder) {
              varsServicio[clave] = resolverPassword(clave);
            }
          }

          const totalVars = Object.keys(varsServicio).length;
          if (totalVars > 0) {
            envPorServicio[servicio] = varsServicio;
            totalCount += totalVars;
          }
        }

        if (totalCount === 0) {
          return { texto: '# This stack does not require mandatory environment variables.', total: 0 };
        }

        let lineas = [
          '# ========================================================',
          '# Environment variables autogenerated by SelfHostDeck',
          '# Passwords and cryptographic keys generated on the fly.',
          '# ========================================================\n'
        ];

        for (const [servicio, vars] of Object.entries(envPorServicio)) {
          lineas.push(`# --- ${servicio.toUpperCase()} ---`);
          for (const [k, v] of Object.entries(vars)) {
            lineas.push(`${k}=${v}`);
          }
          lineas.push('');
        }

        return { texto: lineas.join('\n'), total: totalCount };
      }

      function inicializarEstado() {
        const urlParams = new URLSearchParams(window.location.search);
        const toolsParam = urlParams.get('tools');

        if (toolsParam) {
          toolsParam.split(',').forEach((slug) => {
            const trimmed = slug.trim();
            if (window.ALL_TOOLS.some((t) => t.slug === trimmed)) {
              selectedSlugs.add(trimmed);
            }
          });
        } else {
          try {
            const guardado = JSON.parse(localStorage.getItem('selfhost_stacker_slugs') || '[]');
            guardado.forEach((s) => {
              if (window.ALL_TOOLS.some((t) => t.slug === s)) {
                selectedSlugs.add(s);
              }
            });
          } catch (e) {}
        }
        renderCatalogo();
        actualizarStack();
      }

      function renderCatalogo() {
        toolsContainer.innerHTML = '';

        const filtradas = window.ALL_TOOLS.filter((tool) => {
          const coincideCat = currentCategory === 'all' || tool.categoria === currentCategory;
          const coincideBusqueda =
            tool.nombre.toLowerCase().includes(searchQuery) ||
            (tool.saas_alternativa && tool.saas_alternativa.toLowerCase().includes(searchQuery));
          return coincideCat && coincideBusqueda;
        });

        if (filtradas.length === 0) {
          toolsContainer.innerHTML = '<div style="color: #64748b; font-size: 0.9rem; text-align: center; padding: 2rem 0;">No tools with Docker Compose available.</div>';
          return;
        }

        filtradas.forEach((tool) => {
          const isSelected = selectedSlugs.has(tool.slug);
          const div = document.createElement('div');
          div.className = `tool-item ${isSelected ? 'selected' : ''}`;
          div.innerHTML = `
            <div>
              <div class="tool-info-title">${tool.nombre}</div>
              <div class="tool-info-sub">Alt. to ${tool.saas_alternativa || 'SaaS'} · ★ ${tool.estrellas}</div>
            </div>
            <button type="button" class="btn-add ${isSelected ? 'selected' : ''}" data-slug="${tool.slug}">
              ${isSelected ? '✕ Remove' : '+ Add'}
            </button>
          `;
          toolsContainer.appendChild(div);
        });

        toolsContainer.querySelectorAll('.btn-add').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const slug = e.currentTarget.getAttribute('data-slug');
            toggleTool(slug);
          });
        });
      }

      function toggleTool(slug) {
        if (selectedSlugs.has(slug)) {
          selectedSlugs.delete(slug);
        } else {
          selectedSlugs.add(slug);
        }
        guardarEstado();
        renderCatalogo();
        actualizarStack();
      }

      function guardarEstado() {
        const arr = Array.from(selectedSlugs);
        localStorage.setItem('selfhost_stacker_slugs', JSON.stringify(arr));

        const url = new URL(window.location);
        if (arr.length > 0) {
          url.searchParams.set('tools', arr.join(','));
        } else {
          url.searchParams.delete('tools');
        }
        window.history.replaceState({}, '', url);
      }

      function actualizarVisor() {
        if (activeTab === 'yaml') {
          codeOutput.textContent = currentYaml;
          btnDownload.textContent = 'Download .yml';
        } else {
          codeOutput.textContent = currentEnv;
          btnDownload.textContent = 'Download .env';
        }
      }

      function actualizarStack() {
        if (typeof jsyaml === 'undefined') {
          setTimeout(actualizarStack, 50);
          return;
        }

        const selectedTools = window.ALL_TOOLS.filter((t) => selectedSlugs.has(t.slug));

        selectedChips.innerHTML = '';
        if (selectedTools.length === 0) {
          selectedChips.innerHTML = '<span style="color: #64748b; font-size: 0.85rem;">No tools selected</span>';
          currentYaml = '# Select tools from the left panel to compose your stack.';
          currentEnv = '# No environment variables.';
          envBadge.textContent = '0';
          collisionAlert.style.display = 'none';
          actualizarVisor();
          return;
        }

        selectedTools.forEach((tool) => {
          const chip = document.createElement('span');
          chip.className = 'chip';
          chip.innerHTML = `${tool.nombre} <span class="chip-remove" data-slug="${tool.slug}">&times;</span>`;
          selectedChips.appendChild(chip);
        });

        selectedChips.querySelectorAll('.chip-remove').forEach((el) => {
          el.addEventListener('click', (e) => {
            const slug = e.currentTarget.getAttribute('data-slug');
            toggleTool(slug);
          });
        });

        const finalStack = {
          services: {},
          networks: {
            homelab_network: {
              driver: 'bridge'
            }
          }
        };

        const globalVolumes = {};
        const puertoUso = {};

        selectedTools.forEach((tool) => {
          try {
            const parsed = jsyaml.load(tool.docker_compose);
            if (!parsed || typeof parsed !== 'object') return;

            const services = parsed.services || parsed;

            Object.entries(services).forEach(([serviceName, serviceDef]) => {
              if (['version', 'volumes', 'networks', 'name'].includes(serviceName)) return;
              if (typeof serviceDef !== 'object' || serviceDef === null) return;

              const cleanDef = { ...serviceDef };

              if (Array.isArray(cleanDef.ports)) {
                cleanDef.ports.forEach((p) => {
                  const portStr = String(p);
                  const match = portStr.match(/^["']?(\d+):/);
                  if (match) {
                    const hostPort = match[1];
                    if (!puertoUso[hostPort]) puertoUso[hostPort] = [];
                    if (!puertoUso[hostPort].includes(tool.nombre)) {
                      puertoUso[hostPort].push(tool.nombre);
                    }
                  }
                });
              }

              cleanDef.networks = ['homelab_network'];
              finalStack.services[serviceName] = cleanDef;
            });

            if (parsed.volumes && typeof parsed.volumes === 'object') {
              Object.assign(globalVolumes, parsed.volumes);
            }
          } catch (err) {
            console.warn(`Could not process YAML for ${tool.nombre}:`, err);
          }
        });

        if (Object.keys(globalVolumes).length > 0) {
          finalStack.volumes = globalVolumes;
        }

        const colisiones = Object.entries(puertoUso).filter(([puerto, tools]) => tools.length > 1);
        if (colisiones.length > 0) {
          collisionAlert.style.display = 'block';
          collisionAlert.innerHTML = `
            <strong>⚠️ Port conflict detected:</strong><br/>
            ${colisiones.map(([p, tools]) => `Host port <code>${p}</code> is being used simultaneously by: <strong>${tools.join(' and ')}</strong>. Remember to change one of them before deploying.`).join('<br/>')}
          `;
        } else {
          collisionAlert.style.display = 'none';
        }

        try {
          currentYaml = jsyaml.dump(finalStack, {
            indent: 2,
            lineWidth: -1,
            noRefs: true
          });
        } catch (e) {
          currentYaml = '# Error structuring docker-compose.yml file';
        }

        const envData = extraerEnvAutomatico(finalStack);
        currentEnv = envData.texto;
        envBadge.textContent = envData.total;

        actualizarVisor();
      }

      // Tab Events
      tabYaml.addEventListener('click', () => {
        activeTab = 'yaml';
        tabYaml.classList.add('active');
        tabEnv.classList.remove('active');
        actualizarVisor();
      });

      tabEnv.addEventListener('click', () => {
        activeTab = 'env';
        tabEnv.classList.add('active');
        tabYaml.classList.remove('active');
        actualizarVisor();
      });

      btnClearStack.addEventListener('click', () => {
        selectedSlugs.clear();
        guardarEstado();
        renderCatalogo();
        actualizarStack();
      });

      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        renderCatalogo();
      });

      categoryFilters.querySelectorAll('.pill').forEach((pill) => {
        pill.addEventListener('click', (e) => {
          categoryFilters.querySelectorAll('.pill').forEach((p) => p.classList.remove('active'));
          e.currentTarget.classList.add('active');
          currentCategory = e.currentTarget.getAttribute('data-cat');
          renderCatalogo();
        });
      });

      btnCopy.addEventListener('click', async () => {
        try {
          const texto = activeTab === 'yaml' ? currentYaml : currentEnv;
          await navigator.clipboard.writeText(texto);
          const original = btnCopy.textContent;
          btnCopy.textContent = 'Copied! ✓';
          btnCopy.classList.add('copied');
          setTimeout(() => {
            btnCopy.textContent = original;
            btnCopy.classList.remove('copied');
          }, 2000);
        } catch (err) {}
      });

      btnDownload.addEventListener('click', () => {
        const esYaml = activeTab === 'yaml';
        const contenido = esYaml ? currentYaml : currentEnv;
        const nombreArchivo = esYaml ? 'docker-compose.yml' : '.env';
        const mime = esYaml ? 'text/yaml;charset=utf-8' : 'text/plain;charset=utf-8';

        const blob = new Blob([contenido], { type: mime });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = nombreArchivo;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      btnShare.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          btnShare.textContent = 'Copied! ✓';
          btnShare.classList.add('copied');
          setTimeout(() => {
            btnShare.textContent = 'Share';
            btnShare.classList.remove('copied');
          }, 2000);
        } catch (err) {}
      });

      const scriptTag = document.getElementById('jsyaml-cdn');
      if (window.jsyaml) {
        inicializarEstado();
      } else if (scriptTag) {
        scriptTag.addEventListener('load', inicializarEstado);
      } else {
        window.addEventListener('DOMContentLoaded', inicializarEstado);
      }
    </script>

    <div style="margin-top: 4rem;">
      <Footer />
    </div>
  </body>
</html>