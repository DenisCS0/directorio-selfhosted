---
import { createClient } from '@supabase/supabase-js';
import { toSlug } from '../../../utils/slug';

export async function getStaticPaths() {
  const supabaseUrl = 'https://lffmkpexmtjwtvlgvkcj.supabase.co';
  const supabaseKey = 'sb_publishable_2GbOzXCVwdEOeZj62jhTPA_cuWUn2Bs';
  const client = createClient(supabaseUrl, supabaseKey);

  const { data: herramientas } = await client
    .from('herramientas')
    .select('*');

  const allTools = herramientas || [];

  return allTools.map((item) => {
    const sameCategory = allTools
      .filter((h) => (h.id ? h.id !== item.id : h.nombre !== item.nombre) && h.categoria === item.categoria)
      .sort((a, b) => (b.estrellas || 0) - (a.estrellas || 0));

    let related = sameCategory.slice(0, 3);

    if (related.length < 3) {
      const remaining = allTools
        .filter((h) => (h.id ? h.id !== item.id : h.nombre !== item.nombre) && !related.some((r) => r.nombre === h.nombre))
        .sort((a, b) => (b.estrellas || 0) - (a.estrellas || 0))
        .slice(0, 3 - related.length);
      related = [...related, ...remaining];
    }

    return {
      params: { slug: item.slug || toSlug(item.nombre) },
      props: { item, related },
    };
  });
}

const { item, related = [] } = Astro.props;

if (!item) {
  return Astro.redirect('/en');
}

function formatRam(mb: number | undefined | null) {
  const val = mb || 512;
  return val >= 1024 ? `${val / 1024} GB` : `${val} MB`;
}

const getDifficultyInfo = (diff: string = '') => {
  const d = diff.toLowerCase();
  if (d.includes('fácil') || d.includes('facil') || d.includes('baja') || d.includes('easy') || d.includes('low')) {
    return { label: 'Low', bg: '#052e16', text: '#4ade80', border: '#15803d' };
  }
  if (d.includes('media') || d.includes('medium')) {
    return { label: 'Medium', bg: '#451a03', text: '#facc15', border: '#b45309' };
  }
  if (d.includes('alta') || d.includes('avanzada') || d.includes('difícil') || d.includes('dificil') || d.includes('hard') || d.includes('high')) {
    return { label: 'High', bg: '#450a0a', text: '#f87171', border: '#b91c1c' };
  }
  return { label: diff, bg: '#1e293b', text: '#38bdf8', border: '#334155' };
};

const diffInfo = getDifficultyInfo(item.dificultad_docker || '');

const categoria = item.categoria_en || item.categoria;
const descripcion = item.descripcion_en || item.descripcion;
const ventajas = (item.ventajas_frente_saas_en && item.ventajas_frente_saas_en.length > 0)
  ? item.ventajas_frente_saas_en
  : item.ventajas_frente_saas;

let dockerCompose = item.docker_compose || '';
if (dockerCompose.includes('Este proyecto no incluye un archivo docker-compose')) {
  dockerCompose = `# This project does not include an official docker-compose file in the repository root.
# Check the official installation instructions at:
# ${item.url_repo || 'https://github.com'}`;
}

const currentSlug = item.slug || toSlug(item.nombre);
const urlEs = `/herramienta/${currentSlug}`;
const urlEn = `/en/herramienta/${currentSlug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": item.nombre,
  "operatingSystem": "Linux, Docker",
  "applicationCategory": categoria,
  "description": descripcion,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": Math.max(item.estrellas || 10, 10),
    "bestRating": "5",
    "worstRating": "1"
  }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{item.nombre} - Alternative to {item.saas_alternativa} | SelfHostDeck</title>
    <meta name="description" content={`In-depth breakdown of ${item.nombre}, a self-hosted open-source alternative to ${item.saas_alternativa}. Docker configuration and benefits over cloud SaaS.`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="canonical" href={`https://selfhostdeck.com${urlEn}`} />
    <link rel="alternate" hreflang="en" href={`https://selfhostdeck.com${urlEn}`} />
    <link rel="alternate" hreflang="es" href={`https://selfhostdeck.com${urlEs}`} />
    <link rel="alternate" hreflang="x-default" href={`https://selfhostdeck.com${urlEn}`} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <style>
      * { box-sizing: border-box; }

      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #0f172a;
        color: #e2e8f0;
        max-width: 800px;
        margin: 0 auto;
        padding: 3rem 1.5rem;
        line-height: 1.6;
      }

      .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
      }

      a.volver {
        color: #38bdf8;
        text-decoration: none;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        transition: opacity 0.2s;
      }
      a.volver:hover { 
        opacity: 0.8; 
        text-decoration: underline;
      }

      .lang-switch {
        display: inline-flex;
        align-items: center;
        background: #131d31;
        border: 1px solid #334155;
        border-radius: 9999px;
        padding: 0.2rem 0.5rem;
        gap: 0.35rem;
        font-size: 0.8rem;
        font-weight: 700;
      }

      .lang-switch a {
        color: #94a3b8;
        text-decoration: none;
        padding: 0.25rem 0.6rem;
        border-radius: 9999px;
        transition: all 0.2s ease;
      }

      .lang-switch a:hover { color: #ffffff; }
      .lang-switch a.active {
        background: #0284c7;
        color: #ffffff;
      }

      .lang-divider {
        color: #334155;
        font-size: 0.75rem;
        user-select: none;
      }

      .tag-group {
        display: flex;
        gap: 0.55rem;
        align-items: center;
        flex-wrap: wrap;
      }

      .badge {
        background: #0369a1;
        color: #bae6fd;
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
      }

      .badge-diff {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
        border: 1px solid;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }

      .badge-ram {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        background: rgba(56, 189, 248, 0.1);
        color: #7dd3fc;
        border: 1px solid rgba(56, 189, 248, 0.25);
        font-size: 0.8rem;
        font-weight: 600;
        padding: 0.3rem 0.8rem;
        border-radius: 6px;
      }

      .badge-arm {
        display: inline-flex;
        align-items: center;
        background: rgba(168, 85, 247, 0.12);
        color: #c084fc;
        border: 1px solid rgba(168, 85, 247, 0.3);
        font-size: 0.8rem;
        font-weight: 700;
        padding: 0.3rem 0.75rem;
        border-radius: 6px;
        letter-spacing: 0.02em;
      }

      h1 { 
        font-size: 2.25rem; 
        color: #ffffff; 
        margin: 1rem 0 0.4rem 0; 
        font-weight: 800; 
        letter-spacing: -0.025em;
      }

      .sub { 
        color: #94a3b8; 
        font-size: 1.1rem; 
        margin-bottom: 2rem; 
      }
      .sub strong { color: #f59e0b; }

      .box { 
        background: #1e293b; 
        border: 1px solid #334155; 
        padding: 1.5rem 1.75rem; 
        border-radius: 10px; 
        margin-bottom: 1.5rem; 
      }

      h2 { 
        color: #38bdf8; 
        font-size: 1.25rem; 
        margin-top: 0; 
        margin-bottom: 0.8rem; 
        font-weight: 700; 
      }

      ul.ventajas-list {
        list-style-type: none;
        padding-left: 0;
        margin: 0;
      }
      ul.ventajas-list li {
        margin-bottom: 0.6rem;
        color: #cbd5e1;
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
      }
      ul.ventajas-list li::before {
        content: "✓";
        color: #38bdf8;
        font-weight: bold;
      }

      .docker-box {
        background: #090d16;
        border: 1px solid #233147;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 1.5rem;
      }

      .docker-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #131d2e;
        padding: 0.65rem 1.2rem;
        border-bottom: 1px solid #233147;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .docker-filename {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: #94a3b8;
        font-size: 0.85rem;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-weight: 500;
      }

      .docker-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-wrap: wrap;
      }

      .tool-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #1e293b;
        color: #f1f5f9;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 0.35rem 0.7rem;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
      }
      .tool-btn:hover {
        background: #334155;
        border-color: #475569;
        color: #ffffff;
      }
      .tool-btn.active-state {
        background: #052e16;
        border-color: #15803d;
        color: #4ade80;
      }

      /* Featured CTA for the Stacker */
      .tool-btn.btn-stacker-cta {
        background: rgba(56, 189, 248, 0.12);
        color: #38bdf8;
        border-color: rgba(56, 189, 248, 0.35);
      }
      .tool-btn.btn-stacker-cta:hover {
        background: #0284c7;
        color: #ffffff;
        border-color: #0284c7;
        box-shadow: 0 0 12px rgba(2, 132, 199, 0.35);
      }

      .code-content {
        padding: 1.25rem;
        overflow-x: auto;
      }

      pre.code-block {
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.875rem;
        color: #7dd3fc;
        line-height: 1.55;
        tab-size: 2;
      }

      .btn {
        display: inline-block;
        background: #0284c7;
        color: white;
        text-decoration: none;
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        font-weight: 600;
        transition: background-color 0.2s;
      }
      .btn:hover { background: #0369a1; }

      .related-section {
        margin-top: 3.5rem;
        padding-top: 2rem;
        border-top: 1px solid #334155;
      }

      .related-header {
        font-size: 1.3rem;
        color: #ffffff;
        font-weight: 700;
        margin-bottom: 1.25rem;
      }

      .related-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 1rem;
      }

      .related-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 1.1rem;
        text-decoration: none;
        color: inherit;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .related-card:hover {
        transform: translateY(-2px);
        border-color: #38bdf8;
      }

      .related-card-title {
        font-weight: 700;
        color: #ffffff;
        font-size: 1rem;
        margin-bottom: 0.35rem;
      }

      .related-card-sub {
        font-size: 0.8rem;
        color: #94a3b8;
        line-height: 1.4;
        margin-bottom: 0.75rem;
      }

      .related-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.75rem;
        color: #38bdf8;
        font-weight: 600;
      }

      .related-card-stars { color: #f59e0b; }
    </style>
  </head>
  <body>
    <div class="top-nav">
      <a href="/en" class="volver" id="btnVolver">&larr; Back to catalog</a>
      <div class="lang-switch">
        <a href={urlEs}>ES</a>
        <span class="lang-divider">/</span>
        <a href={urlEn} class="active">EN</a>
      </div>
    </div>

    <div>
      <div class="tag-group">
        <span class="badge">{categoria}</span>
        {item.dificultad_docker && (
          <span 
            class="badge-diff" 
            style={`background: ${diffInfo.bg}; color: ${diffInfo.text}; border-color: ${diffInfo.border};`}
          >
            Docker: {diffInfo.label}
          </span>
        )}
        <span class="badge-ram">
          ⚡ {formatRam(item.ram_mb)} RAM
        </span>
        {item.compatible_arm !== false && (
          <span class="badge-arm">ARM64</span>
        )}
      </div>
      <h1>{item.nombre}</h1>
      <p class="sub">
        Open-source alternative to <strong>{item.saas_alternativa}</strong> · ⭐ {item.estrellas} stars
      </p>
    </div>

    <div class="box">
      <h2>Description & Purpose</h2>
      <p>{descripcion}</p>
    </div>

    {ventajas && ventajas.length > 0 && (
      <div class="box">
        <h2>Key Advantages over Commercial Software</h2>
        <ul class="ventajas-list">
          {ventajas.map((v: string) => (
            <li>{v}</li>
          ))}
        </ul>
      </div>
    )}

    {dockerCompose && (
      <div class="docker-box">
        <div class="docker-header">
          <div class="docker-filename">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
            <span>docker-compose.yml</span>
          </div>

          <div class="docker-actions">
            <!-- Direct link to Stacker with current tool preselected -->
            <a
              href={`/en/stacker?tools=${currentSlug}`}
              class="tool-btn btn-stacker-cta"
              title="Combine this tool with others in the Stacker"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m16 16 4-4-4-4"></path>
                <path d="M20 12H8"></path>
                <path d="m8 8-4 4 4 4"></path>
              </svg>
              <span>Combine in Stacker</span>
            </a>

            <button class="tool-btn" id="downloadBtn" type="button" aria-label="Download docker-compose.yml">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
              </svg>
              <span>Download</span>
            </button>

            <button class="tool-btn" id="copyBtn" type="button" aria-label="Copy Docker Compose">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="btn-text">Copy</span>
            </button>

            <button class="tool-btn" id="shareBtn" type="button" aria-label="Share tool">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
              <span class="btn-text">Share</span>
            </button>
          </div>
        </div>

        <div class="code-content">
          <pre class="code-block"><code id="dockerCode">{dockerCompose}</code></pre>
        </div>
      </div>
    )}

    <a href={item.url_repo} target="_blank" rel="noopener noreferrer" class="btn">
      View code on GitHub &rarr;
    </a>

    {related.length > 0 && (
      <section class="related-section">
        <h3 class="related-header">Other recommended tools</h3>
        <div class="related-grid">
          {related.map((r: any) => (
            <a href={`/en/herramienta/${r.slug || toSlug(r.nombre)}`} class="related-card">
              <div>
                <div class="related-card-title">{r.nombre}</div>
                <div class="related-card-sub">Alt. to {r.saas_alternativa}</div>
              </div>
              <div class="related-card-footer">
                <span class="related-card-stars">★ {r.estrellas}</span>
                <span>View tool &rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <script is:inline define:vars={{ toolName: item.nombre }}>
      const copyBtn = document.getElementById('copyBtn');
      const downloadBtn = document.getElementById('downloadBtn');
      const shareBtn = document.getElementById('shareBtn');
      const dockerCode = document.getElementById('dockerCode');

      // 1. Copy Compose
      if (copyBtn && dockerCode) {
        copyBtn.addEventListener('click', async () => {
          const text = dockerCode.innerText.trim();
          const btnText = copyBtn.querySelector('.btn-text');

          try {
            await navigator.clipboard.writeText(text);
            copyBtn.classList.add('active-state');
            if (btnText) btnText.textContent = 'Copied! ✓';

            setTimeout(() => {
              copyBtn.classList.remove('active-state');
              if (btnText) btnText.textContent = 'Copy';
            }, 2000);
          } catch (err) {
            console.error('Error copying to clipboard:', err);
          }
        });
      }

      // 2. Download docker-compose.yml
      if (downloadBtn && dockerCode) {
        downloadBtn.addEventListener('click', () => {
          const text = dockerCode.innerText.trim();
          const blob = new Blob([text], { type: 'text/yaml;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `${toolName.toLowerCase().replace(/[^a-z0-9]/g, '-')}-compose.yml`;
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          URL.revokeObjectURL(url);
        });
      }

      // 3. Share tool
      if (shareBtn) {
        shareBtn.addEventListener('click', async () => {
          const shareData = {
            title: `${toolName} | SelfHostDeck`,
            text: `Check out the Docker Compose configuration for ${toolName} on SelfHostDeck:`,
            url: window.location.href,
          };

          const btnText = shareBtn.querySelector('.btn-text');

          if (navigator.share && navigator.canShare && navigator.canShare(shareData)) {
            try {
              await navigator.share(shareData);
            } catch (err) {}
          } else {
            try {
              await navigator.clipboard.writeText(window.location.href);
              shareBtn.classList.add('active-state');
              if (btnText) btnText.textContent = 'Link copied! ✓';

              setTimeout(() => {
                shareBtn.classList.remove('active-state');
                if (btnText) btnText.textContent = 'Share';
              }, 2000);
            } catch (err) {
              console.error('Error copying link:', err);
            }
          }
        });
      }

      const btnVolver = document.getElementById('btnVolver');
      const paginaGuardada = sessionStorage.getItem('ultimaPaginaCatalogo');

      if (btnVolver && paginaGuardada && paginaGuardada !== '1') {
        btnVolver.href = `/en/${paginaGuardada}`;
      }
    </script>
  </body>
</html>