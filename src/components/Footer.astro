---
// src/components/Footer.astro
interface Props {
  lang?: 'es' | 'en';
}

const { lang } = Astro.props;
const isEn = lang === 'en' || Astro.url.pathname.startsWith('/en');

const links = isEn ? [
  { href: '/en/about', label: 'About' },
  { href: '/en/contact', label: 'Contact' },
  { href: '/rss.xml', label: 'RSS Feed', isExternal: true, isRss: true },
  { href: '/en/privacy', label: 'Privacy Policy' },
  { href: '/en/legal-notice', label: 'Legal Notice' }
] : [
  { href: '/sobre-el-proyecto', label: 'Sobre el proyecto' },
  { href: '/contacto', label: 'Contacto' },
  { href: '/rss.xml', label: 'RSS Feed', isExternal: true, isRss: true },
  { href: '/privacidad', label: 'Privacidad' },
  { href: '/aviso-legal', label: 'Aviso Legal' }
];

const copyright = isEn 
  ? '© 2026 SelfHostDeck. Directory of open-source alternatives.'
  : '© 2026 SelfHostDeck. Directorio de alternativas Open-Source.';
---

<footer class="site-footer">
  <div class="footer-links">
    {links.map((link) => (
      <a 
        href={link.href}
        target={link.isExternal ? '_blank' : undefined}
        rel={link.isExternal ? 'noopener noreferrer' : undefined}
        class={link.isRss ? 'rss-link' : undefined}
      >
        {link.isRss && (
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            width="14" 
            height="14" 
            viewBox="0 0 24 24" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2.2" 
            stroke-linecap="round" 
            stroke-linejoin="round"
            class="rss-icon"
          >
            <path d="M4 11a9 9 0 0 1 9 9" />
            <path d="M4 4a16 16 0 0 1 16 16" />
            <circle cx="5" cy="19" r="1" />
          </svg>
        )}
        {link.label}
      </a>
    ))}
  </div>
  <p>{copyright}</p>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: 1200px;
    margin: 4rem auto 2rem auto;
    padding-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    text-align: center;
    color: #64748b;
    font-size: 0.875rem;
  }
  .footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .footer-links a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .footer-links a:hover {
    color: #38bdf8;
  }
  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .rss-icon {
    color: #f97316;
    transition: transform 0.2s ease;
  }
  .rss-link:hover .rss-icon {
    transform: scale(1.15);
  }
</style>