import { createClient } from '@supabase/supabase-js';
import { toSlug } from '../../utils/slug';
import Footer from '../../components/Footer.astro';

const supabaseUrl = 'https://lffmkpexmtjwtvlgvkcj.supabase.co';
const supabaseKey = 'sb_publishable_2GbOzXCVwdEOeZj62jhTPA_cuWUn2Bs';
const client = createClient(supabaseUrl, supabaseKey);

const { data: herramientas, error } = await client
  .from('herramientas')
  .select('*')
  .order('estrellas', { ascending: false });

if (error) {
  console.error('Error loading tools for the Stacker:', error);
}

const herramientasDisponibles = (herramientas || []).filter((h) => {
  if (!h.docker_compose) return false;
  return !h.docker_compose.includes('no incluye un archivo docker-compose');
}).map((h) => ({
  ...h,
  categoria: h.categoria_en || h.categoria,
  slug: h.slug || toSlug(h.nombre)
}));

const categorias = [...new Set(herramientasDisponibles.map((h) => h.categoria))].filter(Boolean);
