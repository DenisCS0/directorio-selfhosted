---
import { createClient } from '@supabase/supabase-js';
import { toSlug } from '../../utils/slug';
import Footer from '../../components/Footer.astro';

const supabaseUrl = 'https://lffmkpexmtjwtvlgvkcj.supabase.co';
const supabaseKey = 'sb_publishable_2GbOzXCVwdEOeZj62jhTPA_cuWUn2Bs';
const client = createClient(supabaseUrl, supabaseKey);

const { data: herramientas, error } = await client
  .from('herramientas')
  .select('*')
  .order('estrellas', { ascending: false });

if (error) {
  console.error('Error loading tools for the Stacker:', error);
}

const herramientasDisponibles = (herramientas || []).filter((h) => {
  if (!h.docker_compose) return false;
  return !h.docker_compose.includes('no incluye un archivo docker-compose');
}).map((h) => ({
  ...h,
  categoria: h.categoria_en || h.categoria,
  slug: h.slug || toSlug(h.nombre)
}));

const categorias = [...new Set(herramientasDisponibles.map((h) => h.categoria))].filter(Boolean);
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Docker Compose Stacker | Multi-Container Generator | SelfHostDeck</title>
    <meta name="description" content="Combine multiple open-source applications into a single production-ready docker-compose.yml file. Automatic port conflict detection." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Cargador de JS-YAML con ID para control de carga -->
    <script id="jsyaml-cdn" src="https://cdn.jsdelivr.net/npm/js-yaml@4.1.0/dist/js-yaml.min.js"></script>

    <style is:global>
      * { box-sizing: border-box; }
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #0f172a;
        color: #e2e8f0;
        margin: 0;
        padding: 2rem 1.5rem;
        line-height: 1.5;
      }

      .container {
        max-width: 1300px;
        margin: 0 auto;
      }

      .top-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
      }

      a.volver {
        color: #38bdf8;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-weight: 500;
      }
      a.volver:hover { text-decoration: underline; }

      /* Selector de idioma ES / EN */
      .lang-switch {
        display: inline-flex;
        background: #1e293b;
        border: 1px solid #334155;
        border-radius: 9999px;
        padding: 0.2rem 0.35rem;
        gap: 0.3rem;
        font-size: 0.75rem;
        font-weight: 700;
      }
      .lang-switch a {
        text-decoration: none;
        padding: 0.15rem 0.5rem;
        border-radius: 9999px;
        color: #94a3b8;
      }
      .lang-switch a.active {
        background: #0284c7;
        color: #ffffff;
      }

      .header-section {
        margin-bottom: 2.5rem;
      }

      h1 {
        font-size: 2.5rem;
        font-weight: 800;
        color: #ffffff;
        margin: 0 0 0.5rem 0;
        letter-spacing: -0.025em;
      }

      p.sub {
        color: #94a3b8;
        font-size: 1.1rem;
        margin: 0;
      }

      /* Grid principal */
      .stacker-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
      }

      @media (max-width: 960px) {
        .stacker-grid { 
          grid-template-columns: 1fr; 
        }
      }

      .panel,
      .sticky-panel {
        min-width: 0;
      }

      .panel {
        background: #131d31;
        border: 1px solid #233147;
        border-radius: 12px;
        padding: 1.5rem;
      }

      .search-box {
        width: 100%;
        background: #090d16;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        color: #ffffff;
        font-size: 0.95rem;
        margin-bottom: 1rem;
        outline: none;
      }
      .search-box:focus { border-color: #38bdf8; }

      .filter-pills {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
      }

      .pill {
        background: #1e293b;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 9999px;
        padding: 0.25rem 0.75rem;
        font-size: 0.75rem;
        cursor: pointer;
        user-select: none;
        transition: all 0.2s ease;
      }
      .pill:hover, .pill.active {
        background: #0284c7;
        border-color: #38bdf8;
        color: #ffffff;
      }

      .tools-list {
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        max-height: 650px;
        overflow-y: auto;
        padding: 4px 0.35rem 4px 2px;
      }

      .tools-list::-webkit-scrollbar { width: 6px; }
      .tools-list::-webkit-scrollbar-track { background: #090d16; }
      .tools-list::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }

      /* Tarjeta de cada herramienta */
      .tool-item {
        background: #172236;
        border: 1px solid #2b3a51;
        border-radius: 10px;
        padding: 0.85rem 1.1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      }
      
      .tool-item:hover { 
        border-color: #38bdf8;
        background: #1c2b44;
        transform: translateY(-1px);
        box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.4);
      }

      .tool-item.selected {
        border-color: rgba(56, 189, 248, 0.6);
        background: rgba(14, 34, 56, 0.95);
        box-shadow: 0 0 0 1px rgba(56, 189, 248, 0.3);
      }

      .tool-info-title {
        font-weight: 700;
        color: #ffffff;
        font-size: 0.95rem;
      }

      .tool-info-sub {
        font-size: 0.78rem;
        color: #94a3b8;
        margin-top: 0.2rem;
      }

      /* Botón de añadir/quitar */
      .btn-add {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        background: rgba(56, 189, 248, 0.12);
        color: #38bdf8;
        border: 1px solid rgba(56, 189, 248, 0.35);
        border-radius: 8px;
        padding: 0.45rem 0.85rem;
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: all 0.18s ease;
      }

      .btn-add:hover { 
        background: #0284c7;
        color: #ffffff;
        border-color: #0284c7;
        box-shadow: 0 0 12px rgba(2, 132, 199, 0.4);
        transform: scale(1.02);
      }

      .btn-add.selected {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.35);
      }

      .btn-add.selected:hover {
        background: #dc2626;
        color: #ffffff;
        border-color: #dc2626;
        box-shadow: 0 0 12px rgba(220, 38, 38, 0.4);
      }

      .sticky-panel {
        position: sticky;
        top: 2rem;
      }

      .stack-header-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.65rem;
      }

      .btn-clear {
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 0.25rem 0.6rem;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
      }
      .btn-clear:hover {
        background: #450a0a;
        border-color: #b91c1c;
        color: #fca5a5;
      }

      .selected-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-bottom: 1rem;
        min-height: 28px;
      }

      .chip {
        background: #0369a1;
        color: #bae6fd;
        border-radius: 6px;
        padding: 0.25rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
      }
      .chip-remove {
        cursor: pointer;
        font-weight: 800;
      }
      .chip-remove:hover { color: #ffffff; }

      .alert-box {
        background: #450a0a;
        border: 1px solid #b91c1c;
        color: #fca5a5;
        border-radius: 8px;
        padding: 0.85rem 1rem;
        margin-bottom: 1rem;
        font-size: 0.85rem;
        display: none;
      }

      .yaml-container {
        background: #090d16;
        border: 1px solid #233147;
        border-radius: 8px;
        overflow: hidden;
      }

      .yaml-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #131d2e;
        padding: 0.65rem 1rem;
        border-bottom: 1px solid #233147;
      }

      .yaml-title {
        font-family: ui-monospace, monospace;
        font-size: 0.85rem;
        color: #94a3b8;
      }

      .yaml-actions {
        display: flex;
        gap: 0.5rem;
      }

      .btn-action {
        background: #1e293b;
        color: #f1f5f9;
        border: 1px solid #334155;
        border-radius: 6px;
        padding: 0.35rem 0.65rem;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }
      .btn-action:hover { background: #334155; }
      .btn-action.copied { background: #052e16; border-color: #15803d; color: #4ade80; }

      pre.yaml-code {
        margin: 0;
        padding: 1.25rem;
        max-height: 520px;
        overflow: auto;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.82rem;
        color: #7dd3fc;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="top-nav">
        <a href="/en" class="volver">&larr; Back to catalog</a>
        <div class="lang-switch">
          <a href="/stacker">ES</a>
          <a href="/en/stacker" class="active">EN</a>
        </div>
      </div>

      <div class="header-section">
        <h1>Docker Compose Stacker</h1>
        <p class="sub">
          Select the tools you need and generate a unified file ready to run on your server.
        </p>
      </div>

      <div class="stacker-grid">
        <!-- Panel Izquierdo: Selección -->
        <div class="panel">
          <input
            type="text"
            id="searchInput"
            class="search-box"
            placeholder="Search by name or alternative (e.g. Plex, Immich, Notion)..."
          />

          <div class="filter-pills" id="categoryFilters">
            <button class="pill active" data-cat="all">All</button>
            {categorias.map((cat) => (
              <button class="pill" data-cat={cat}>{cat}</button>
            ))}
          </div>

          <div class="tools-list" id="toolsContainer"></div>
        </div>

        <!-- Panel Derecho: Salida YAML -->
        <div class="sticky-panel">
          <div class="panel">
            <div class="stack-header-row">
              <span style="font-weight: 700;">Your Stack:</span>
              <button class="btn-clear" id="btnClearStack">Clear stack</button>
            </div>

            <div class="selected-chips" id="selectedChips">
              <span style="color: #64748b; font-size: 0.85rem;">No tools selected</span>
            </div>

            <div class="alert-box" id="collisionAlert"></div>

            <div class="yaml-container">
              <div class="yaml-header">
                <span class="yaml-title">docker-compose.yml</span>
                <div class="yaml-actions">
                  <button class="btn-action" id="btnShare">Share link</button>
                  <button class="btn-action" id="btnDownload">Download</button>
                  <button class="btn-action" id="btnCopy">Copy</button>
                </div>
              </div>
              <pre class="yaml-code"><code id="yamlOutput"># Select tools from the left panel to compose your stack.</code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Inyección de datos sin peticiones en runtime -->
    <script define:vars={{ herramientasDisponibles }}>
      window.ALL_TOOLS = herramientasDisponibles;
    </script>

    <script is:inline>
      let selectedSlugs = new Set();
      let currentCategory = 'all';
      let searchQuery = '';

      const toolsContainer = document.getElementById('toolsContainer');
      const selectedChips = document.getElementById('selectedChips');
      const yamlOutput = document.getElementById('yamlOutput');
      const collisionAlert = document.getElementById('collisionAlert');
      const searchInput = document.getElementById('searchInput');
      const categoryFilters = document.getElementById('categoryFilters');
      const btnCopy = document.getElementById('btnCopy');
      const btnDownload = document.getElementById('btnDownload');
      const btnShare = document.getElementById('btnShare');
      const btnClearStack = document.getElementById('btnClearStack');

      function inicializarEstado() {
        const urlParams = new URLSearchParams(window.location.search);
        const toolsParam = urlParams.get('tools');

        if (toolsParam) {
          toolsParam.split(',').forEach((slug) => {
            const trimmed = slug.trim();
            if (window.ALL_TOOLS.some((t) => t.slug === trimmed)) {
              selectedSlugs.add(trimmed);
            }
          });
        } else {
          try {
            const guardado = JSON.parse(localStorage.getItem('selfhost_stacker_slugs') || '[]');
            guardado.forEach((s) => {
              if (window.ALL_TOOLS.some((t) => t.slug === s)) {
                selectedSlugs.add(s);
              }
            });
          } catch (e) {}
        }
        renderCatalogo();
        actualizarStack();
      }

      function renderCatalogo() {
        toolsContainer.innerHTML = '';

        const filtradas = window.ALL_TOOLS.filter((tool) => {
          const coincideCat = currentCategory === 'all' || tool.categoria === currentCategory;
          const coincideBusqueda =
            tool.nombre.toLowerCase().includes(searchQuery) ||
            (tool.saas_alternativa && tool.saas_alternativa.toLowerCase().includes(searchQuery));
          return coincideCat && coincideBusqueda;
        });

        if (filtradas.length === 0) {
          toolsContainer.innerHTML = '<div style="color: #64748b; font-size: 0.9rem; text-align: center; padding: 2rem 0;">No tools with Docker Compose available.</div>';
          return;
        }

        filtradas.forEach((tool) => {
          const isSelected = selectedSlugs.has(tool.slug);
          const div = document.createElement('div');
          div.className = `tool-item ${isSelected ? 'selected' : ''}`;
          div.innerHTML = `
            <div>
              <div class="tool-info-title">${tool.nombre}</div>
              <div class="tool-info-sub">Alt. to ${tool.saas_alternativa || 'SaaS'} · ★ ${tool.estrellas}</div>
            </div>
            <button type="button" class="btn-add ${isSelected ? 'selected' : ''}" data-slug="${tool.slug}">
              ${isSelected ? '✕ Remove' : '+ Add'}
            </button>
          `;
          toolsContainer.appendChild(div);
        });

        toolsContainer.querySelectorAll('.btn-add').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const slug = e.currentTarget.getAttribute('data-slug');
            toggleTool(slug);
          });
        });
      }

      function toggleTool(slug) {
        if (selectedSlugs.has(slug)) {
          selectedSlugs.delete(slug);
        } else {
          selectedSlugs.add(slug);
        }
        guardarEstado();
        renderCatalogo();
        actualizarStack();
      }

      function guardarEstado() {
        const arr = Array.from(selectedSlugs);
        localStorage.setItem('selfhost_stacker_slugs', JSON.stringify(arr));

        const url = new URL(window.location);
        if (arr.length > 0) {
          url.searchParams.set('tools', arr.join(','));
        } else {
          url.searchParams.delete('tools');
        }
        window.history.replaceState({}, '', url);
      }

      function actualizarStack() {
        if (typeof jsyaml === 'undefined') {
          setTimeout(actualizarStack, 50);
          return;
        }

        const selectedTools = window.ALL_TOOLS.filter((t) => selectedSlugs.has(t.slug));

        selectedChips.innerHTML = '';
        if (selectedTools.length === 0) {
          selectedChips.innerHTML = '<span style="color: #64748b; font-size: 0.85rem;">No tools selected</span>';
          yamlOutput.textContent = '# Select tools from the left panel to compose your stack.';
          collisionAlert.style.display = 'none';
          return;
        }

        selectedTools.forEach((tool) => {
          const chip = document.createElement('span');
          chip.className = 'chip';
          chip.innerHTML = `${tool.nombre} <span class="chip-remove" data-slug="${tool.slug}">&times;</span>`;
          selectedChips.appendChild(chip);
        });

        selectedChips.querySelectorAll('.chip-remove').forEach((el) => {
          el.addEventListener('click', (e) => {
            const slug = e.currentTarget.getAttribute('data-slug');
            toggleTool(slug);
          });
        });

        const finalStack = {
          services: {},
          networks: {
            homelab_network: {
              driver: 'bridge'
            }
          }
        };

        const globalVolumes = {};
        const puertoUso = {};

        selectedTools.forEach((tool) => {
          try {
            const parsed = jsyaml.load(tool.docker_compose);
            if (!parsed || typeof parsed !== 'object') return;

            const services = parsed.services || parsed;

            Object.entries(services).forEach(([serviceName, serviceDef]) => {
              if (['version', 'volumes', 'networks', 'name'].includes(serviceName)) return;
              if (typeof serviceDef !== 'object' || serviceDef === null) return;

              const cleanDef = { ...serviceDef };

              if (Array.isArray(cleanDef.ports)) {
                cleanDef.ports.forEach((p) => {
                  const portStr = String(p);
                  const match = portStr.match(/^["']?(\d+):/);
                  if (match) {
                    const hostPort = match[1];
                    if (!puertoUso[hostPort]) puertoUso[hostPort] = [];
                    if (!puertoUso[hostPort].includes(tool.nombre)) {
                      puertoUso[hostPort].push(tool.nombre);
                    }
                  }
                });
              }

              cleanDef.networks = ['homelab_network'];
              finalStack.services[serviceName] = cleanDef;
            });

            if (parsed.volumes && typeof parsed.volumes === 'object') {
              Object.assign(globalVolumes, parsed.volumes);
            }
          } catch (err) {
            console.warn(`Could not process YAML for ${tool.nombre}:`, err);
          }
        });

        if (Object.keys(globalVolumes).length > 0) {
          finalStack.volumes = globalVolumes;
        }

        const colisiones = Object.entries(puertoUso).filter(([puerto, tools]) => tools.length > 1);
        if (colisiones.length > 0) {
          collisionAlert.style.display = 'block';
          collisionAlert.innerHTML = `
            <strong>⚠️ Port conflict detected:</strong><br/>
            ${colisiones.map(([p, tools]) => `Host port <code>${p}</code> is being used simultaneously by: <strong>${tools.join(' and ')}</strong>. Remember to change one of them before deploying.`).join('<br/>')}
          `;
        } else {
          collisionAlert.style.display = 'none';
        }

        try {
          yamlOutput.textContent = jsyaml.dump(finalStack, {
            indent: 2,
            lineWidth: -1,
            noRefs: true
          });
        } catch (e) {
          yamlOutput.textContent = '# Error structuring docker-compose.yml file';
        }
      }

      btnClearStack.addEventListener('click', () => {
        selectedSlugs.clear();
        guardarEstado();
        renderCatalogo();
        actualizarStack();
      });

      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        renderCatalogo();
      });

      categoryFilters.querySelectorAll('.pill').forEach((pill) => {
        pill.addEventListener('click', (e) => {
          categoryFilters.querySelectorAll('.pill').forEach((p) => p.classList.remove('active'));
          e.currentTarget.classList.add('active');
          currentCategory = e.currentTarget.getAttribute('data-cat');
          renderCatalogo();
        });
      });

      btnCopy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(yamlOutput.textContent);
          btnCopy.textContent = 'Copied! ✓';
          btnCopy.classList.add('copied');
          setTimeout(() => {
            btnCopy.textContent = 'Copy';
            btnCopy.classList.remove('copied');
          }, 2000);
        } catch (err) {}
      });

      btnDownload.addEventListener('click', () => {
        const blob = new Blob([yamlOutput.textContent], { type: 'text/yaml;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'docker-compose.yml';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });

      btnShare.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          btnShare.textContent = 'Link copied! ✓';
          btnShare.classList.add('copied');
          setTimeout(() => {
            btnShare.textContent = 'Share link';
            btnShare.classList.remove('copied');
          }, 2000);
        } catch (err) {}
      });

      const scriptTag = document.getElementById('jsyaml-cdn');
      if (window.jsyaml) {
        inicializarEstado();
      } else if (scriptTag) {
        scriptTag.addEventListener('load', inicializarEstado);
      } else {
        window.addEventListener('DOMContentLoaded', inicializarEstado);
      }
    </script>
    <div style="margin-top: 4rem;">
      <Footer />
    </div>
  </body>
</html>