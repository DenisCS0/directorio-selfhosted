---
// src/components/LanguagePicker.astro
const { currentLang = 'es' } = Astro.props;
---

<div class="lang-switcher">
  <a href="/" class={currentLang === 'es' ? 'active' : ''}>ES</a>
  <span class="divider">/</span>
  <a href="/en" class={currentLang === 'en' ? 'active' : ''}>EN</a>
</div>

<style>
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    background: #1e293b;
    padding: 0.3rem 0.75rem;
    border-radius: 20px;
    border: 1px solid #334155;
  }
  .lang-switcher a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .lang-switcher a:hover {
    color: #ffffff;
  }
  .lang-switcher a.active {
    color: #38bdf8;
  }
  .divider {
    color: #475569;
  }
</style>