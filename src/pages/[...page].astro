---
import { createClient } from '@supabase/supabase-js';
import Footer from '../components/Footer.astro';
import { toSlug } from '../utils/slug';

export async function getStaticPaths({ paginate }) {
  const supabaseUrl = 'https://lffmkpexmtjwtvlgvkcj.supabase.co';
  const supabaseKey = 'sb_publishable_2GbOzXCVwdEOeZj62jhTPA_cuWUn2Bs';
  const supabase = createClient(supabaseUrl, supabaseKey);

  const { data: herramientas, error } = await supabase
    .from('herramientas')
    .select('*')
    .order('estrellas', { ascending: false });

  if (error) {
    console.error('Error al consultar Supabase:', error);
    return [];
  }

  const items = herramientas || [];
  const categorias = ['Todas', ...new Set(items.map((h) => h.categoria).filter(Boolean))];

  // Datos ligeros para la búsqueda global en memoria con hardware
  const catalogoCompleto = items.map((h) => ({
    id: h.id,
    slug: h.slug || toSlug(h.nombre || ''),
    nombre: h.nombre || '',
    saas_alternativa: h.saas_alternativa || '',
    categoria: h.categoria || '',
    descripcion: h.descripcion || '',
    estrellas: h.estrellas || 0,
    created_at: h.created_at || null,
    ram_mb: h.ram_mb || 512,
    compatible_arm: h.compatible_arm !== false,
  }));

  return paginate(items, {
    pageSize: 12,
    props: { 
      categorias,
      catalogoCompleto
    },
  });
}

const { page, categorias, catalogoCompleto } = Astro.props;
const currentNum = page.currentPage;
const urlEs = currentNum === 1 ? '/' : `/${currentNum}`;
const urlEn = currentNum === 1 ? '/en' : `/en/${currentNum}`;

// Días de antigüedad máxima para considerar una herramienta como "Nueva"
const DIAS_LIMITE_NUEVO = 14;

// Función auxiliar para formatear la RAM
function formatRam(mb: number | undefined | null) {
  const val = mb || 512;
  return val >= 1024 ? `${val / 1024} GB` : `${val} MB`;
}

// Estructura JSON-LD para Google (Schema.org)
const schemaItemList = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `SelfHostDeck | Directorio Self-Hosted vs SaaS (Página ${page.currentPage})`,
  "description": "Descubre las mejores alternativas autoalojadas y de código abierto al software SaaS comercial.",
  "url": `https://selfhostdeck.com${urlEs === '/' ? '' : urlEs}`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": page.data.length,
    "itemListElement": page.data.map((item: any, idx: number) => ({
      "@type": "ListItem",
      "position": page.start + idx + 1,
      "name": item.nombre,
      "url": `https://selfhostdeck.com/herramienta/${item.slug || toSlug(item.nombre)}`,
      "description": item.descripcion
    }))
  }
};
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SelfHostDeck | Directorio Self-Hosted vs SaaS (Página {page.currentPage})</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="SelfHostDeck RSS Feed" href="https://selfhostdeck.com/rss.xml" />

  <!-- Metadatos SEO y Canonical -->
  <meta name="description" content="Descubre las mejores alternativas autoalojadas y de código abierto al software SaaS comercial. Controla tus datos y tu homelab." />
  <link rel="canonical" href={`https://selfhostdeck.com${page.url.current === '/' ? '' : page.url.current}`} />

  <!-- Etiquetas Hreflang Bidireccionales -->
  <link rel="alternate" hreflang="es" href={`https://selfhostdeck.com${urlEs}`} />
  <link rel="alternate" hreflang="en" href={`https://selfhostdeck.com${urlEn}`} />
  <link rel="alternate" hreflang="x-default" href={`https://selfhostdeck.com${urlEn}`} />

  <!-- Datos Estructurados JSON-LD (Schema.org) -->
  <script type="application/ld+json" set:html={JSON.stringify(schemaItemList)} />

  <!-- Tarjetas para Discord, Twitter y Redes -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://selfhostdeck.com/" />
  <meta property="og:site_name" content="SelfHostDeck" />
  <meta property="og:title" content="SelfHostDeck | Find Self-Hosted SaaS Alternatives" />
  <meta property="og:description" content="Descubre herramientas open-source potentes para reemplazar servicios en la nube." />
  <meta property="og:image" content="https://selfhostdeck.com/og-image.png" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content="https://selfhostdeck.com/" />
  <meta name="twitter:title" content="SelfHostDeck | Find Self-Hosted SaaS Alternatives" />
  <meta name="twitter:description" content="Descubre herramientas open-source potentes para reemplazar servicios en la nube." />
  <meta name="twitter:image" content="https://selfhostdeck.com/og-image.png" />
  
  <style is:global>
    :root {
      --bg: #0b1120;
      --card-bg: #1e293b;
      --card-border: #334155;
      --primary: #38bdf8;
      --primary-glow: rgba(56, 189, 248, 0.2);
      --text: #e2e8f0;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; }
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      max-width: 1200px;
      margin: 0 auto;
      padding: 3rem 1.5rem;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* Cabecera */
    header {
      text-align: center;
      margin-bottom: 3rem;
    }
    h1 {
      font-size: 2.5rem;
      font-weight: 800;
      letter-spacing: -0.025em;
      background: linear-gradient(to right, #38bdf8, #818cf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin: 0 0 0.75rem 0;
    }
    .subtitulo {
      color: var(--text-muted);
      font-size: 1.1rem;
      max-width: 600px;
      margin: 0 auto 2rem auto;
      line-height: 1.5;
    }

    /* Botonera de herramientas destacadas */
    .cta-group {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.85rem;
      margin: 1.5rem auto 2.5rem auto;
    }

    .cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.9rem;
      font-weight: 600;
      padding: 0.65rem 1.25rem;
      border-radius: 8px;
      text-decoration: none;
      transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .cta-btn-primary {
      background: #0284c7;
      color: #ffffff;
      box-shadow: 0 4px 14px rgba(2, 132, 199, 0.35);
    }

    .cta-btn-primary:hover {
      background: #0369a1;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(2, 132, 199, 0.45);
    }

    .cta-btn-secondary {
      background: #131d31;
      color: #e2e8f0;
      border: 1px solid var(--card-border);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    }

    .cta-btn-secondary:hover {
      background: #1e293b;
      border-color: var(--primary);
      color: #ffffff;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(56, 189, 248, 0.15);
    }

    .cta-badge {
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      background: rgba(56, 189, 248, 0.15);
      color: var(--primary);
      border: 1px solid rgba(56, 189, 248, 0.3);
      padding: 0.15rem 0.45rem;
      border-radius: 4px;
    }

    /* Contenedor del Buscador */
    .search-wrapper {
      max-width: 680px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .search-input-group {
      position: relative;
      display: flex;
      align-items: center;
    }

    .search-icon {
      position: absolute;
      left: 1.25rem;
      width: 20px;
      height: 20px;
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      padding: 1rem 1rem 1rem 3.25rem;
      background: #131d31;
      border: 1px solid var(--card-border);
      border-radius: 12px;
      color: #ffffff;
      font-size: 1rem;
      outline: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
    }

    .search-input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px var(--primary-glow), 0 4px 20px -2px rgba(0, 0, 0, 0.4);
      background: #17233d;
    }

    .search-input::placeholder {
      color: #64748b;
    }

    /* Filtros en píldoras */
    .filter-pills {
      display: flex;
      gap: 0.5rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .pill {
      background: #1e293b;
      border: 1px solid var(--card-border);
      color: var(--text-muted);
      padding: 0.4rem 0.9rem;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .pill:hover {
      background: #28364d;
      color: #ffffff;
    }

    .pill.active {
      background: #0284c7;
      color: #ffffff;
      border-color: #38bdf8;
    }

    /* Filtros de hardware */
    .hardware-filters {
      display: flex;
      gap: 0.6rem;
      justify-content: center;
      flex-wrap: wrap;
      margin-top: 0.15rem;
    }

    .hw-toggle {
      background: #131d31;
      border: 1px solid #334155;
      color: #94a3b8;
      padding: 0.35rem 0.8rem;
      border-radius: 8px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s ease;
      user-select: none;
    }

    .hw-toggle:hover {
      border-color: #38bdf8;
      color: #ffffff;
    }

    .hw-toggle.active {
      background: rgba(56, 189, 248, 0.15);
      border-color: #38bdf8;
      color: #38bdf8;
      box-shadow: 0 0 12px rgba(56, 189, 248, 0.2);
    }

    /* Contador */
    .counter {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
      font-weight: 500;
    }

    /* Grid de tarjetas */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.5rem;
    }

    .card {
      position: relative;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      color: inherit;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-3px);
      border-color: var(--primary);
      box-shadow: 0 10px 25px -5px var(--primary-glow);
    }

    /* Cabecera de la tarjeta: solo Categoría y NUEVO */
    .card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.75rem;
      min-height: 26px;
    }

    .card-top .badge {
      margin-bottom: 0;
    }

    .badge-nuevo {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: rgba(16, 185, 129, 0.12);
      color: #34d399;
      border: 1px solid rgba(16, 185, 129, 0.3);
      padding: 0.18rem 0.5rem;
      border-radius: 6px;
      position: relative;
      z-index: 2;
      white-space: nowrap;
    }

    .pulse-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: #34d399;
      box-shadow: 0 0 6px #34d399;
      animation: pulsoVerde 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    @keyframes pulsoVerde {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.3; transform: scale(0.85); }
    }

    .main-link {
      color: #ffffff;
      text-decoration: none;
    }

    .main-link::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
    }

    .badge {
      display: inline-block;
      background: #0369a1;
      color: #bae6fd;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 0.25rem 0.6rem;
      border-radius: 6px;
      margin-bottom: 0.75rem;
      width: fit-content;
      position: relative;
      z-index: 2;
    }

    h2 {
      margin: 0 0 0.5rem 0;
      font-size: 1.35rem;
      font-weight: 700;
    }

    .reemplaza {
      color: #cbd5e1;
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
      position: relative;
      z-index: 2;
    }
    .reemplaza strong { color: #f59e0b; }

    .sub-link {
      color: #cbd5e1;
      text-decoration: underline;
      text-underline-offset: 3px;
      transition: color 0.15s ease;
    }
    .sub-link:hover {
      color: var(--primary);
    }

    .resumen {
      color: var(--text-muted);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }

    /* Pie de la tarjeta: Estrellas + RAM + ARM64 agrupados */
    .meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid var(--card-border);
      padding-top: 1rem;
      gap: 0.6rem;
    }

    .meta-left {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      flex-wrap: wrap;
      position: relative;
      z-index: 2;
    }

    .badge-ram {
      display: inline-flex;
      align-items: center;
      gap: 0.2rem;
      background: rgba(56, 189, 248, 0.1);
      color: #7dd3fc;
      border: 1px solid rgba(56, 189, 248, 0.25);
      font-size: 0.7rem;
      font-weight: 600;
      padding: 0.15rem 0.45rem;
      border-radius: 5px;
      line-height: 1.2;
    }

    .badge-arm {
      display: inline-flex;
      align-items: center;
      background: rgba(168, 85, 247, 0.12);
      color: #c084fc;
      border: 1px solid rgba(168, 85, 247, 0.3);
      font-size: 0.7rem;
      font-weight: 700;
      padding: 0.15rem 0.4rem;
      border-radius: 5px;
      letter-spacing: 0.02em;
      line-height: 1.2;
    }

    .estrellas {
      color: #facc15;
      font-size: 0.88rem;
      font-weight: 600;
      margin-right: 0.15rem;
    }

    .btn {
      color: var(--primary);
      font-size: 0.9rem;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      white-space: nowrap;
      transition: gap 0.15s ease;
    }

    .card:hover .btn {
      text-decoration: underline;
      gap: 0.5rem;
    }

    .no-results {
      display: none;
      text-align: center;
      color: var(--text-muted);
      font-size: 1.1rem;
      grid-column: 1 / -1;
      padding: 4rem 0;
    }

    /* Paginación Numérica */
    .pagination {
      grid-column: 1 / -1;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      margin-top: 3.5rem;
      margin-bottom: 1rem;
    }

    .page-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.4rem;
      height: 2.4rem;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text);
      border-radius: 8px;
      font-size: 1rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .page-link:hover:not(.disabled) {
      border-color: var(--primary);
      background: #28364d;
      color: #ffffff;
      transform: translateY(-1px);
    }

    .page-link.disabled {
      opacity: 0.3;
      pointer-events: none;
      cursor: not-allowed;
    }

    .page-numbers {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .page-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.4rem;
      height: 2.4rem;
      padding: 0 0.5rem;
      border-radius: 8px;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text);
      font-size: 0.9rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .page-num:hover:not(.active) {
      border-color: var(--primary);
      background: #28364d;
      color: #ffffff;
      transform: translateY(-1px);
    }

    .page-num.active {
      background: #0284c7;
      border-color: var(--primary);
      color: #ffffff;
      pointer-events: none;
    }

    /* Barra superior y selector de idioma */
    .top-nav {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 1rem;
    }

    .lang-switch {
      display: inline-flex;
      align-items: center;
      background: #131d31;
      border: 1px solid var(--card-border);
      border-radius: 9999px;
      padding: 0.2rem 0.5rem;
      gap: 0.35rem;
      font-size: 0.8rem;
      font-weight: 700;
    }

    .lang-switch a {
      color: var(--text-muted);
      text-decoration: none;
      padding: 0.25rem 0.6rem;
      border-radius: 9999px;
      transition: all 0.2s ease;
    }

    .lang-switch a:hover {
      color: #ffffff;
    }

    .lang-switch a.active {
      background: #0284c7;
      color: #ffffff;
    }

    .lang-divider {
      color: #334155;
      font-size: 0.75rem;
      user-select: none;
    }
  </style>
</head>
<body>
  <header>
    <!-- Selector de Idioma -->
    <div class="top-nav">
      <div class="lang-switch">
        <a href={urlEs} class="active">ES</a>
        <span class="lang-divider">/</span>
        <a href={urlEn}>EN</a>
      </div>
    </div>
    <h1>Alternativas Open-Source y Self-Hosted</h1>
    <p class="subtitulo">Opciones gratuitas y centradas en tu privacidad frente al software de pago, analizadas localmente por IA.</p>

    <!-- Botonera de navegación destacada -->
    <div class="cta-group">
      <a href="/stacks" class="cta-btn cta-btn-primary">
        ⚡ Explorar Homelab Stacks Docker
      </a>
      <a href="/stacker" class="cta-btn cta-btn-secondary">
        🧩 Docker Compose Stacker
        <span class="cta-badge">Nuevo</span>
      </a>
    </div>

    <div class="search-wrapper">
      <div class="search-input-group">
        <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input 
          type="text" 
          id="buscador" 
          class="search-input" 
          placeholder="Buscar por herramienta, alternativa o tecnología (ej. Photos, Notion, n8n)..." 
        />
      </div>

      <!-- Filtro por categorías -->
      <div class="filter-pills" id="contenedor-filtros">
        {categorias.map((cat) => (
          <button class={`pill ${cat === 'Todas' ? 'active' : ''}`} data-cat={cat.toLowerCase()}>
            {cat}
          </button>
        ))}
      </div>

      <!-- Filtros de Hardware / Recursos -->
      <div class="hardware-filters" id="hardware-filters">
        <button type="button" class="hw-toggle" id="toggle-low-ram" data-active="false">
          ⚡ Bajo consumo (&le; 512 MB)
        </button>
        <button type="button" class="hw-toggle" id="toggle-arm" data-active="false">
          🥧 Compatible ARM / Pi
        </button>
      </div>
    </div>
  </header>

  <div class="counter" id="contador-resultados">
    Mostrando {page.start + 1} - {page.end + 1} de {page.total} herramientas (Página {page.currentPage} de {page.lastPage})
  </div>

  <main class="grid" id="contenedor-cards">
    <!-- Contenedor estático paginado -->
    <div id="cards-estaticas" style="display: contents;">
      {page.data.map((item) => {
        const dias = item.created_at
          ? (Date.now() - new Date(item.created_at).getTime()) / (1000 * 60 * 60 * 24)
          : 999;
        const esNueva = dias <= DIAS_LIMITE_NUEVO;

        return (
          <article class="card">
            <div>
              <div class="card-top">
                <span class="badge">{item.categoria}</span>
                {esNueva && (
                  <span class="badge-nuevo">
                    <span class="pulse-dot"></span>
                    Nuevo
                  </span>
                )}
              </div>
              <h2>
                <a href={`/herramienta/${item.slug || toSlug(item.nombre)}`} class="main-link">
                  {item.nombre}
                </a>
              </h2>
              <p class="reemplaza">
                <strong>Sustituye a:</strong>{" "}
                {item.saas_alternativa ? item.saas_alternativa.split('/').map((s: string, idx: number, arr: string[]) => {
                  const name = s.trim();
                  const slug = toSlug(name);
                  return (
                    <>
                      <a href={`/alternativas/${slug}`} class="sub-link">{name}</a>
                      {idx < arr.length - 1 ? ' / ' : ''}
                    </>
                  );
                }) : 'N/A'}
              </p>
              <p class="resumen">{item.descripcion}</p>
            </div>
            <div class="meta">
              <div class="meta-left">
                <span class="estrellas">★ {item.estrellas}</span>
                <span class="badge-ram">⚡ {formatRam(item.ram_mb)}</span>
                {item.compatible_arm !== false && (
                  <span class="badge-arm">ARM64</span>
                )}
              </div>
              <span class="btn">
                Ver análisis <span>&rarr;</span>
              </span>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Contenedor dinámico para búsquedas globales -->
    <div id="cards-dinamicas" style="display: contents;"></div>

    <div id="sin-resultados" class="no-results">
      🔍 No se encontraron herramientas que coincidan con tu búsqueda en todo el catálogo.
    </div>

    <!-- Paginación Numérica -->
    <nav class="pagination" id="nav-paginacion" aria-label="Navegación de páginas">
      {page.url.prev ? (
        <a href={page.url.prev} class="page-link" aria-label="Página anterior">←</a>
      ) : (
        <span class="page-link disabled" aria-hidden="true">←</span>
      )}

      <div class="page-numbers">
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => {
          const url = num === 1 ? '/' : `/${num}`;
          const isActive = num === page.currentPage;
          return isActive ? (
            <span class="page-num active" aria-current="page">{num}</span>
          ) : (
            <a href={url} class="page-num">{num}</a>
          );
        })}
      </div>

      {page.url.next ? (
        <a href={page.url.next} class="page-link" aria-label="Página siguiente">→</a>
      ) : (
        <span class="page-link disabled" aria-hidden="true">→</span>
      )}
    </nav>
  </main>

  <Footer />

  <!-- Índice JSON global incrustado -->
  <script id="catalogo-datos" type="application/json" set:html={JSON.stringify(catalogoCompleto)} />

  <script>
    interface Tool {
      id: string | number;
      slug: string;
      nombre: string;
      saas_alternativa: string;
      categoria: string;
      descripcion: string;
      estrellas: number;
      created_at?: string | null;
      ram_mb?: number;
      compatible_arm?: boolean;
    }

    function toSlug(text: string): string {
      return text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '');
    }

    function formatRam(mb: number | undefined | null): string {
      const val = mb || 512;
      return val >= 1024 ? `${val / 1024} GB` : `${val} MB`;
    }

    const catalogoEl = document.getElementById('catalogo-datos');
    const todosLosDatos: Tool[] = catalogoEl ? JSON.parse(catalogoEl.textContent || '[]') : [];

    const buscador = document.getElementById('buscador') as HTMLInputElement;
    const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
    const contador = document.getElementById('contador-resultados');
    const sinResultados = document.getElementById('sin-resultados');
    const navPaginacion = document.getElementById('nav-paginacion');
    const cardsEstaticas = document.getElementById('cards-estaticas');
    const cardsDinamicas = document.getElementById('cards-dinamicas');

    const toggleLowRam = document.getElementById('toggle-low-ram') as HTMLButtonElement;
    const toggleArm = document.getElementById('toggle-arm') as HTMLButtonElement;

    const textoContadorOriginal = contador?.textContent || '';
    let currentCategory = 'todas';
    let filterLowRam = false;
    let filterArm = false;
    const DIAS_LIMITE_NUEVO = 14;

    function escaparHTML(texto: string) {
      const div = document.createElement('div');
      div.textContent = texto;
      return div.innerHTML;
    }

    function crearTarjetaHTML(item: Tool) {
      const linksSaaS = item.saas_alternativa
        ? item.saas_alternativa.split('/').map((s, idx, arr) => {
            const nombre = s.trim();
            const slug = toSlug(nombre);
            const sep = idx < arr.length - 1 ? ' / ' : '';
            return `<a href="/alternativas/${slug}" class="sub-link">${escaparHTML(nombre)}</a>${sep}`;
          }).join('')
        : 'N/A';

      const dias = item.created_at
        ? (Date.now() - new Date(item.created_at).getTime()) / (1000 * 60 * 60 * 24)
        : 999;
      const esNueva = dias <= DIAS_LIMITE_NUEVO;

      const badgeNuevoHtml = esNueva
        ? `<span class="badge-nuevo"><span class="pulse-dot"></span>Nuevo</span>`
        : '';

      const badgeArmHtml = item.compatible_arm !== false
        ? `<span class="badge-arm">ARM64</span>`
        : '';

      return `
        <article class="card">
          <div>
            <div class="card-top">
              <span class="badge">${escaparHTML(item.categoria)}</span>
              ${badgeNuevoHtml}
            </div>
            <h2>
              <a href="/herramienta/${escaparHTML(item.slug)}" class="main-link">
                ${escaparHTML(item.nombre)}
              </a>
            </h2>
            <p class="reemplaza"><strong>Sustituye a:</strong> ${linksSaaS}</p>
            <p class="resumen">${escaparHTML(item.descripcion)}</p>
          </div>
          <div class="meta">
            <div class="meta-left">
              <span class="estrellas">★ ${item.estrellas}</span>
              <span class="badge-ram">⚡ ${formatRam(item.ram_mb)}</span>
              ${badgeArmHtml}
            </div>
            <span class="btn">
              Ver análisis <span>&rarr;</span>
            </span>
          </div>
        </article>
      `;
    }

    function filtrarGlobal() {
      const query = buscador.value.toLowerCase().trim();
      const estaBuscando = query !== '' || currentCategory !== 'todas' || filterLowRam || filterArm;

      if (!estaBuscando) {
        if (cardsEstaticas) cardsEstaticas.style.display = 'contents';
        if (cardsDinamicas) {
          cardsDinamicas.style.display = 'none';
          cardsDinamicas.innerHTML = '';
        }
        if (navPaginacion) navPaginacion.style.display = 'flex';
        if (sinResultados) sinResultados.style.display = 'none';
        if (contador) contador.textContent = textoContadorOriginal;
        return;
      }

      if (cardsEstaticas) cardsEstaticas.style.display = 'none';
      if (cardsDinamicas) cardsDinamicas.style.display = 'contents';
      if (navPaginacion) navPaginacion.style.display = 'none';

      const coincidencias = todosLosDatos.filter((item) => {
        const matchText =
          item.nombre.toLowerCase().includes(query) ||
          item.saas_alternativa.toLowerCase().includes(query) ||
          item.categoria.toLowerCase().includes(query) ||
          item.descripcion.toLowerCase().includes(query);

        const matchCat =
          currentCategory === 'todas' ||
          item.categoria.toLowerCase() === currentCategory;

        const matchRam = !filterLowRam || (item.ram_mb !== undefined && item.ram_mb <= 512);
        const matchArm = !filterArm || item.compatible_arm !== false;

        return matchText && matchCat && matchRam && matchArm;
      });

      if (cardsDinamicas) {
        cardsDinamicas.innerHTML = coincidencias.map(crearTarjetaHTML).join('');
      }

      if (sinResultados) {
        sinResultados.style.display = coincidencias.length === 0 ? 'block' : 'none';
      }

      if (contador) {
        contador.textContent = `Mostrando ${coincidencias.length} herramienta${coincidencias.length === 1 ? '' : 's'} encontrada${coincidencias.length === 1 ? '' : 's'} en el catálogo`;
      }
    }

    buscador?.addEventListener('input', filtrarGlobal);

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => p.classList.remove('active'));
        pill.classList.add('active');
        currentCategory = pill.dataset.cat || 'todas';
        filtrarGlobal();
      });
    });

    toggleLowRam?.addEventListener('click', () => {
      filterLowRam = !filterLowRam;
      toggleLowRam.classList.toggle('active', filterLowRam);
      filtrarGlobal();
    });

    toggleArm?.addEventListener('click', () => {
      filterArm = !filterArm;
      toggleArm.classList.toggle('active', filterArm);
      filtrarGlobal();
    });
  </script>

  <script is:inline define:vars={{ numPagina: page.currentPage }}>
    sessionStorage.setItem('ultimaPaginaCatalogo', String(numPagina));
  </script>
</body>
</html>
