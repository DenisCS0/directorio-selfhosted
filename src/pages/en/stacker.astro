    <link rel="alternate" hreflang="en" href="https://selfhostdeck.com/en/stacker" />
    <link rel="alternate" hreflang="x-default" href="https://selfhostdeck.com/en/stacker" />

    <!-- JS-YAML CDN Loader -->
    <script id="jsyaml-cdn" src="https://cdn.jsdelivr.net/npm/js-yaml@4.1.0/dist/js-yaml.min.js"></script>

    <style is:global>
