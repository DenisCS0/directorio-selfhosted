<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Docker Compose Stacker | Multi-Container Generator | SelfHostDeck</title>
    <meta name="description" content="Combine multiple open-source applications into a single production-ready docker-compose.yml file and automatically generate a secure, linked .env file." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://selfhostdeck.com/en/stacker" />

    <!-- Bidirectional Hreflang Tags -->
